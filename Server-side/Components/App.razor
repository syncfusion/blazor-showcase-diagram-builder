@page "/"
@inject NavigationManager Urihelper
@using DiagramBuilder.Shared

@* SEO Variables - Single source of truth for all meta tags *@
@{
    string SeoTitle = "Diagram Builder - Syncfusion Blazor Showcase";
    string SeoDescription = "Interactive diagram builder for flowcharts, mind maps, and BPMN with drag-and-drop, styling, and export.";
    string SiteUrl = Urihelper.Uri.TrimEnd('/');
    string ApplicationName = "Diagram Builder";
    string Publisher = "Syncfusion";
    string Language = "English";
    string SocialImage = SiteUrl + "/diagram_component.svg";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- HTML Title -->
    <title>@SeoTitle</title>
    
    <!-- Primary Meta Tags -->
    <meta name="title" content="@SeoTitle" />
    <meta name="description" content="@SeoDescription" />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="Diagram Builder, flowcharts, mind maps, BPMN, Blazor components, diagram designer, Syncfusion" />
    <meta name="publisher" content="@Publisher" />
    <meta name="language" content="@Language" />
    
    <!-- Canonical URL -->
    <link href="https://showcase.syncfusion.com/diagram-builder/blazor/" rel="canonical" />
    
    <!-- Alternate Language Tags -->
    <link rel="alternate" hreflang="en-US" href="@SiteUrl" />
    <link rel="alternate" hreflang="x-default" href="@SiteUrl" />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@SeoTitle" />
    <meta property="og:description" content="@SeoDescription" />
    <meta property="og:url" content="@SiteUrl" />
    <meta property="og:site_name" content="@ApplicationName" />
    <meta property="og:image" content="@SocialImage" />
    <meta property="og:image:alt" content="@ApplicationName Logo" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@SeoTitle" />
    <meta name="twitter:description" content="@SeoDescription" />
    <meta name="twitter:image" content="@SocialImage" />
    <meta name="twitter:image:alt" content="@ApplicationName" />
    <meta name="twitter:site" content="@@Syncfusion" />
    
    <base href="/" />
    <!-- Google Tag Manager -->
    <!-- Load GTM-WXZ6DX9B immediately on page load  -->
    <script>
        (function (w, d, s, l, i) {
            w[l] = w[l] || []; w[l].push({
                'gtm.start':
                    new Date().getTime(), event: 'gtm.js'
            }); var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                    'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-WXZ6DX9B');
    </script>
    <!-- Load GTM-W8WD8WN on user interaction -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const events = ["mousemove", "scroll", "keydown", "touchstart"];
            function loadGTM() {
                events.forEach(event => document.removeEventListener(event, loadGTM));
                (function (w, d, s, l, i) {
                    w[l] = w[l] || []; w[l].push({
                        'gtm.start':
                            new Date().getTime(), event: 'gtm.js'
                    }); var f = d.getElementsByTagName(s)[0],
                        j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                            'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
                })(window, document, 'script', 'dataLayer', 'GTM-W8WD8WN');
            }
            events.forEach(event => document.addEventListener(event, loadGTM, { once: true }));
        });
    </script>

    <title>Create flowchart, mind map with Syncfusion diagram builder</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
     <meta name="description" content="An interactive diagram builder built with Blazor, enabling users to create and customize diagrams such as flowcharts, mind maps, and organizational charts with ease.">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <link rel="icon" type="image/x-icon" href="favicon.ico">
    <link href="_content/Syncfusion.Blazor.Themes/fluent2.css" rel="stylesheet" />
    <link href="@Assets["assets/db-icons1/style.css"]" rel="stylesheet" />
    <link href="@Assets["assets/dbstyle/diagrambuilder.css"]" rel="stylesheet" />
    <script src="@Assets["_content/BlazorServerCommon_NET10/interop.js"]" async></script>
    <link rel="stylesheet" href="//maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" />
    <link href='https://fonts.googleapis.com/css?family=Roboto' rel='stylesheet'>
    <script src="@Assets["_content/Syncfusion.Blazor.Diagram/scripts/sf-diagramcomponent.min.js"]"></script>
    <script src="@Assets["_content/Syncfusion.Blazor.Popups/scripts/sf-dialog.min.js"]"></script>
    <script src="@Assets["_content/Syncfusion.Blazor.Inputs/scripts/sf-textbox.min.js"]"></script>
    <script src="@Assets["_content/Syncfusion.Blazor.Inputs/scripts/sf-uploader.min.js"]"></script>
    <script src="@Assets["_content/Syncfusion.Blazor.Inputs/scripts/sf-slider.min.js"]"></script>
    <script src="@Assets["_content/Syncfusion.Blazor.Buttons/scripts/sf-checkbox.min.js"]"></script>
    <script src="@Assets["_content/Syncfusion.Blazor.SplitButtons/scripts/sf-drop-down-button.min.js"]"></script>
    <script src="@Assets["_content/Syncfusion.Blazor.DropDowns/scripts/sf-dropdownlist.min.js"]"></script>
    <script src="@Assets["_content/Syncfusion.Blazor.Inputs/scripts/sf-numerictextbox.min.js"]"></script>
    <script src="@Assets["_content/Syncfusion.Blazor.Inputs/scripts/sf-colorpicker.min.js"]"></script>
    <script src="@Assets["_content/Syncfusion.Blazor.Lists/scripts/sf-listview.min.js"]"></script>
    
    <!-- Schema.org Structured Data - SoftwareApplication -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org/",
      "@@type": "SoftwareApplication",
      "name": "@ApplicationName",
      "description": "@SeoDescription",
      "url": "@SiteUrl",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "image": "@SocialImage",
      "offers": {
        "@@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "author": {
        "@@type": "Organization",
        "name": "@Publisher",
        "url": "https://www.syncfusion.com"
      },
      "inLanguage": "en-US"
    }
    </script>
    
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <!-- Google Tag Manager (noscript) -->
    <!--Page Load-->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WXZ6DX9B" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!--Interaction-->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W8WD8WN" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">

        </environment>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
